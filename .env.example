# LiveKit credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sarvam AI key for default speech-to-text
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI key for default LLM, TTS, and screen vision
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Optional provider keys
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# FRIDAY memory and workspace
OBSIDIAN_VAULT_PATH=/Users/you/Desktop/SecBrain
MEMORY_FOLDER=Memory
WORKSPACE_ROOTS=/Users/you/Desktop

# Human-worker desktop automation
OPENAI_VISION_MODEL=gpt-4o
FRIDAY_REQUIRE_CONFIRMATION=true
FRIDAY_SCREENSHOT_DIR=/tmp/friday-screens
FRIDAY_DESKTOP_EVENT_LOG=/tmp/friday-desktop-events.jsonl

# Odysseus local admin bridge (create token with friday_admin_bridge profile)
ODYSSEUS_BASE_URL=http://127.0.0.1:7870
ODYSSEUS_BRIDGE_TOKEN=

# Optional email defaults
FRIDAY_EMAIL_SUBJECT=Message from FRIDAY

# ── Friday v2: persona (rename before any public deployment) ──
FRIDAY_PERSONA_NAME=FRIDAY
FRIDAY_PERSONA_BOSS=Tony Stark

# ── Friday v2: trust mode ──
# Default arm window in minutes when the boss says "trust mode on" (max 240)
FRIDAY_TRUST_DEFAULT_MINUTES=30

# ── Friday v2: executor (background agents) ──
FRIDAY_SUBAGENT_MODEL=gpt-4o-mini
FRIDAY_EXECUTOR_MAX_STEPS_QUICK=15
FRIDAY_EXECUTOR_MAX_STEPS_DEEP=40
# Extra folders (comma-separated) agents may read/write besides their own workspace
FRIDAY_EXECUTOR_FILE_ROOTS=
# How long a paused job waits for trust mode to be re-armed (seconds)
FRIDAY_EXECUTOR_PAUSE_MAX_S=600

# ── Friday v2: scheduler ──
FRIDAY_SCHEDULER_TICK_S=30

# Knowledge folder for learning jobs, agent workspaces, and trust state
# (defaults to ~/.friday/knowledge)
FRIDAY_KNOWLEDGE_DIR=

# --- Memory intelligence (Tier A port, 2026-06) ---
# Per-turn memory injection: how many search hits ride along each turn.
FRIDAY_PRESEARCH_RESULTS=4
# Reflection cadence: extract stable facts/preferences every N turns.
FRIDAY_REFLECT_EVERY_TURNS=12
# Promotion threshold: recall score at which a memory crystallizes
# into Profile/promoted.md (0..1).
FRIDAY_PROMOTE_THRESHOLD=0.55
